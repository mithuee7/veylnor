# --- Server-side only (set these in Render's Environment tab) ---
# Never prefix these with NEXT_PUBLIC_. They must never reach the browser.

# Supabase project URL (Project Settings -> API -> Project URL)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service-role key (Project Settings -> API -> service_role).
# Full-access key. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq API key (console.groq.com). Server-only. Never expose to the client.
GROQ_API_KEY=your-groq-api-key

# --- Nothing client-side needs to be set here ---
# The Supabase Project URL and anon/public key used by the browser are
# entered once in the app's Settings page and stored in that browser's
# localStorage - they are NOT read from environment variables.

