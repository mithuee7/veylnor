# Server-only secrets
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=

# Required for n8n / external API access
VEYNLOR_API_KEY=

# Private admin dashboard
VEYNLOR_ADMIN_PASSWORD=
VEYNLOR_ADMIN_SESSION_SECRET=

# Optional tuning / diagnostics
# VEYNLOR_MANIFEST_CHARS=20000        # max characters of clip list sent to Groq in one request
# VEYNLOR_SCENE_THRESHOLD=0.2         # FFmpeg scene-change sensitivity (lower = more cuts detected)
# VEYNLOR_DEBUG_PROMPTS=1             # log the exact Groq prompt and raw picks
# VEYNLOR_ENFORCE_CONSTRAINTS=1      # strict mode: forbidden clips are removed before Groq (default: Groq decides)
